# Copy to .env locally. Never commit .env or put private keys in public/ or src/.
NODE_ENV=production
HOST=127.0.0.1
PORT=4175
PUBLIC_ORIGIN=https://your-domain.example
# Public browser token: scope it to imagery/terrain and the intended domain in ion.
CESIUM_ION_TOKEN=replace-with-your-scoped-public-token
# commercial needs an Open-Meteo subscription; disabled makes no provider requests.
# evaluation is accepted only outside production.
WEATHER_MODE=disabled
OPEN_METEO_API_KEY=
